/**
 * Azure Function para validar un voucher de pago desde Event Hub.
 */
public class ClienteVoucherValidator {

    private static final Logger logger = Logger.getLogger(ClienteVoucherValidator.class.getName());


    private static final List<String> PALABRAS_CLAVE_VOUCHER = Arrays.asList(
            "yape", "plin", "bbva", "scotiabank", "interbank", "pichincha",
            "voucher", "transferencia", "operación exitosa", "pago exitoso", "¡yapeaste!", "¡plin y listo!",
            "luis acuña", "luis acuna", "luis a. acuna", "luis andres acuna ramos", "luis andres acuna",
            "977559149", "977 559 149", "*** *** 149",
            "s/8", "s/8.00", "s/.8.00", "s/. 8.00", "s / 8.00", "s/ 8.00", "s/8.0",
            "s/. 8", "s/ 8", "s/ 8.0", "s/ 8.oo", "s/.8", "s. 8.00", "s8", "s /8"
    );



    @FunctionName("ClienteVoucherValidator")
    public void run(
            @EventHubTrigger(
                    name = "clienteEvent",
                    eventHubName = "Clientes-registro-eventhub",
                    connection = "EventHubConnectionString",
                    cardinality = Cardinality.MANY
            ) String[] messages,
            final ExecutionContext context) {

        Logger logger = context.getLogger();
        ObjectMapper objectMapper = new ObjectMapper();

        for (String message : messages) {
            try {
                logger.info("📥 Recibiendo mensaje del Event Hub: " + message);

                JsonNode jsonNode = objectMapper.readTree(message);
                String voucherUrl = jsonNode.get("voucherUrl").asText();

                logger.info("📸 Imagen del voucher recibida: " + voucherUrl);

                if (voucherUrl == null || voucherUrl.isEmpty()) {
                    logger.warning("⚠️ No se encontró URL del voucher en el mensaje.");
                    continue;
                }

                // 🔍 Analizar la imagen con OCR de Azure Cognitive Services
                String ocrResult = analyzeImageWithOCR(voucherUrl);
                logger.info("📄 Resultado del OCR: " + ocrResult);

                boolean isValidVoucher = validateVoucherText(ocrResult);
                String tipoEvento = jsonNode.has("tipo") ? jsonNode.get("tipo").asText() : "registro"; // por defecto "registro"

                if (isValidVoucher) {
                    logger.info("✅ Voucher válido detectado para tipo: " + tipoEvento);
                    if ("renovacion".equalsIgnoreCase(tipoEvento)) {
                        approveRenovationClient(jsonNode.get("clienteId").asText());
                    } else {
                        approveClient(jsonNode.get("clienteId").asText());
                    }
                } else {
                    logger.warning("❌ Voucher inválido o sospechoso.");
                    rejectClient(jsonNode.get("clienteId").asText());
                }


            } catch (Exception e) {
                logger.severe("🚨 Error procesando mensaje: " + e.getMessage());
            }
        }
    }

    /**
     * Envía la imagen del voucher a Azure Cognitive Services para OCR.
     */
    private String analyzeImageWithOCR(String imageUrl) throws Exception {
        String subscriptionKey = System.getenv("OCR_SUBSCRIPTION_KEY");
        String endpoint = System.getenv("OCR_ENDPOINT");

        if (subscriptionKey == null || endpoint == null) {
            throw new RuntimeException("❌ Las credenciales OCR no están configuradas.");
        }

        // ✅ Asegurar que la URL del endpoint no tenga doble barra
        if (endpoint.endsWith("/")) {
            endpoint = endpoint.substring(0, endpoint.length() - 1);
        }

        String ocrApiUrl = endpoint + "/vision/v3.2/ocr?language=es&detectOrientation=true";

        try (CloseableHttpClient httpClient = HttpClients.createDefault()) {
            HttpPost request = new HttpPost(ocrApiUrl);
            request.setHeader("Ocp-Apim-Subscription-Key", subscriptionKey);
            request.setHeader("Content-Type", "application/json");

            // ✅ Asegurar que la URL de la imagen no tenga doble barra
            if (imageUrl.startsWith("/")) {
                imageUrl = imageUrl.substring(1);
            }

            String jsonPayload = "{\"url\": \"" + imageUrl + "\"}";
            request.setEntity(new StringEntity(jsonPayload));

            try (CloseableHttpResponse response = httpClient.execute(request)) {
                return new BufferedReader(new InputStreamReader(response.getEntity().getContent()))
                        .lines()
                        .reduce("", (acc, line) -> acc + line);
            }
        }
    }


    /**
     * Valida si el texto OCR contiene indicios de ser un voucher de pago del día actual.
     */
    /**
     * Valida si el texto OCR contiene indicios de ser un voucher de pago del día actual.
     */
    private boolean validateVoucherText(String ocrText) {

        LocalDate fechaHoy = LocalDate.now(ZoneId.of("America/Lima"));
        Locale locale = new Locale("es", "ES");

        // 📆 Formatos de fecha comunes en vouchers
        List<String> formatos = List.of(
                "d MMM yyyy",
                "d MMM. yyyy",
                "dd MMM yyyy",
                "dd MMM. yyyy",
                "d MMMM yyyy",
                "dd MMMM yyyy",
                "dd/MM/yyyy",
                "d 'de' MMMM 'de' yyyy"
        );

        // 🧰 Generar fechas válidas del día en diferentes formatos
        List<String> fechasDelDia = new ArrayList<>();
        for (String formato : formatos) {
            try {
                String fechaFormateada = fechaHoy.format(DateTimeFormatter.ofPattern(formato, locale)).toLowerCase();
                fechasDelDia.add(fechaFormateada);
                fechasDelDia.add(fechaFormateada.replace(".", "")); // alternativa sin punto
            } catch (Exception ignored) {}
        }

        // 🧼 Limpieza ligera del texto OCR
        String textoLimpio = ocrText.toLowerCase()
                .replaceAll("[.,]", "")     // eliminar puntos y comas
                .replaceAll("\\s+", " ")    // unificar espacios
                .trim();

        // 🔑 Verificar palabra clave
        boolean contienePalabraClave = PALABRAS_CLAVE_VOUCHER.stream()
                .anyMatch(p -> textoLimpio.contains(p.toLowerCase()));

        // 📅 Verificar si contiene la fecha como string exacto
        boolean contieneFechaExacta = fechasDelDia.stream()
                .anyMatch(textoLimpio::contains);

        // 📅 Verificación extra: detectar fecha fragmentada (25 + mar + 2025)
        String dia = String.valueOf(fechaHoy.getDayOfMonth());
        String anio = String.valueOf(fechaHoy.getYear());
        String mesAbrev = fechaHoy.format(DateTimeFormatter.ofPattern("MMM", locale)).toLowerCase().replace(".", "");
        String mesCompleto = fechaHoy.format(DateTimeFormatter.ofPattern("MMMM", locale)).toLowerCase();

        boolean contieneFechaFragmentada = (
                (textoLimpio.contains(" " + dia + " ") || textoLimpio.startsWith(dia + " "))
        ) && (textoLimpio.contains(mesAbrev) || textoLimpio.contains(mesCompleto))
                && textoLimpio.contains(anio);

        boolean contieneFechaDeHoy = contieneFechaExacta || contieneFechaFragmentada;

        // 🪵 Logs para Azure
        logger.info("📝 Texto OCR limpio: " + textoLimpio);
        logger.info("🔑 Palabra clave encontrada: " + contienePalabraClave);
        logger.info("📅 Fecha del día encontrada (exacta): " + contieneFechaExacta);
        logger.info("🧩 Fecha del día encontrada (fragmentada): " + contieneFechaFragmentada);

        if (contienePalabraClave && contieneFechaDeHoy) {
            logger.info("✅ Voucher válido detectado para registro.");
            return true;
        } else {
            logger.warning("❌ Voucher rechazado. Falta palabra clave o fecha del día.");
            return false;
        }
    }





    /**
     * Simula la aprobación del cliente en el backend.
     */

    private void approveClient(String clienteId) {
        logger.info("✅ Iniciando aprobación de cliente: " + clienteId);

        String baseUrl = "https://api.sorteosc.com/api";

        try (CloseableHttpClient httpClient = HttpClients.createDefault()) {
            // Usar GET en lugar de PUT
            String approveClientUrl = baseUrl + "/clients/approve/" + clienteId;
            HttpGet approveClientRequest = new HttpGet(approveClientUrl); // <-- Aquí el cambio

            logger.info("🛠 Enviando solicitud a: " + approveClientUrl);
            try (CloseableHttpResponse clientResponse = httpClient.execute(approveClientRequest)) {
                int statusCode = clientResponse.getCode();
                logger.info("✔️ Cliente aprobado - Status: " + statusCode);
                if (statusCode != 200) {
                    logger.severe("❌ Error al aprobar cliente: " + statusCode);
                }
            } catch (Exception e) {
                logger.severe("❌ Error en solicitud de aprobación de cliente: " + e.getMessage());
                e.printStackTrace();
            }

        } catch (Exception e) {
            logger.severe("❌ Error general al llamar al microservicio: " + e.getMessage());
            e.printStackTrace();
        }
    }


    private void approveRenovationClient(String clienteId) {
        logger.info("🔄 Iniciando aprobación de renovación para cliente: " + clienteId);

        String baseUrl = "https://api.sorteosc.com/api";

        try (CloseableHttpClient httpClient = HttpClients.createDefault()) {
            String approvePaymentUrl = baseUrl + "/payments/approve-payment/" + clienteId;
            HttpGet approvePaymentRequest = new HttpGet(approvePaymentUrl);

            logger.info("🛠 Enviando solicitud GET a: " + approvePaymentUrl);
            try (CloseableHttpResponse response = httpClient.execute(approvePaymentRequest)) {
                int statusCode = response.getCode();
                logger.info("✔️ Renovación aprobada - Status: " + statusCode);
                if (statusCode != 200) {
                    logger.severe("❌ Error al aprobar renovación: " + statusCode);
                }
            } catch (Exception e) {
                logger.severe("❌ Error durante solicitud de aprobación de renovación: " + e.getMessage());
                e.printStackTrace();
            }
        } catch (Exception e) {
            logger.severe("❌ Error general al llamar a endpoint de renovación: " + e.getMessage());
            e.printStackTrace();
        }
    }




    /**
     * Simula el rechazo del cliente en el backend.
     */
    private void rejectClient(String clienteId) {
        logger.info("❌ Iniciando rechazo del cliente: " + clienteId);

        String baseUrl = "https://api.sorteosc.com/api";

        try (CloseableHttpClient httpClient = HttpClients.createDefault()) {
            // Solo se necesita eliminar el cliente, ya que su endpoint elimina también pagos
            String deleteClientUrl = baseUrl + "/clients/" + clienteId;
            HttpDelete deleteClientRequest = new HttpDelete(deleteClientUrl);

            logger.info("🗑 Enviando solicitud DELETE a: " + deleteClientUrl);
            try (CloseableHttpResponse clientResponse = httpClient.execute(deleteClientRequest)) {
                int statusCode = clientResponse.getCode();
                logger.info("🗑 Cliente eliminado (y pagos) - Status: " + statusCode);
                if (statusCode != 200 && statusCode != 204) {
                    logger.severe("❌ Error al eliminar cliente: " + statusCode);
                }
            } catch (Exception e) {
                logger.severe("❌ Error en solicitud de eliminación de cliente: " + e.getMessage());
                e.printStackTrace();
            }

        } catch (Exception e) {
            logger.severe("❌ Error general al llamar al microservicio para eliminación: " + e.getMessage());
            e.printStackTrace();
        }
    }



}
